---
import Base from '../layouts/Base.astro';
import CarteTheme from '../components/CarteTheme.astro';
import { getCollection } from 'astro:content';
import { getThemes, getCandidats, getDerniereMaj, compterMesures, formatDate, url } from '../lib/data';
const themes = await getThemes();
const nbCandidats = (await getCandidats()).length;
const maj = await getDerniereMaj();
const nbVotes = (await getCollection('votes')).length;
const compte = new Map(await Promise.all(themes.map(async (t) => [t.id, await compterMesures(t.id)] as const)));
---
<Base title="Accueil" large>
  <section class="arrivee pt-6 sm:pt-14">
    <h1 class="titre-affiche max-w-[17ch]">Comparez les programmes, <em>sources à l'appui.</em></h1>
    <p class="prose-w mt-6 text-lg text-ink-600">Chaque proposition des candidats à la présidentielle 2027, résumée de la même façon pour tous et reliée au document d'origine. Mis à jour le <time datetime={maj.toISOString().slice(0, 10)}>{formatDate(maj)}</time>.</p>
    <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-line py-6 sm:grid-cols-4">
      <div class="flex flex-col-reverse"><dt class="mt-1 block text-sm text-ink-600">candidats</dt><dd class="chiffre-affiche">{nbCandidats}</dd></div>
      <div class="flex flex-col-reverse"><dt class="mt-1 block text-sm text-ink-600">thèmes</dt><dd class="chiffre-affiche">{themes.length}</dd></div>
      <div class="flex flex-col-reverse"><dt class="mt-1 block text-sm text-ink-600">propositions écrites</dt><dd class="chiffre-affiche">{[...compte.values()].reduce((a, b) => a + b, 0)}</dd></div>
      <div class="flex flex-col-reverse"><dt class="mt-1 block text-sm text-ink-600">votes à l'Assemblée</dt><dd class="chiffre-affiche">{nbVotes}</dd></div>
    </dl>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="#themes" class="btn btn-primary rounded-full px-5">Choisir un thème</a>
      <a href={url('/candidats/')} class="btn btn-secondary rounded-full px-5">Voir par candidat</a>
    </p>
  </section>

  <section id="themes" aria-labelledby="titre-themes" class="mt-16">
    <h2 id="titre-themes" class="text-2xl">Les thèmes</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {themes.map((t) => <li><CarteTheme theme={t} nb={compte.get(t.id) ?? 0} /></li>)}
    </ul>
  </section>

  <section aria-labelledby="titre-lire" class="mt-12 prose-w">
    <h2 id="titre-lire" class="text-xl">Comment lire une fiche</h2>
    <ol class="mt-4 space-y-3">
      <li><strong>1. Situation actuelle.</strong> Les chiffres récents et les règles en vigueur.</li>
      <li><strong>2. Bilan.</strong> Ce que disent les évaluations des politiques déjà menées.</li>
      <li><strong>3. Propositions.</strong> Les mesures de chaque candidat, sous-thème par sous-thème.</li>
      <li><strong>4. Effets attendus.</strong> Coûts et impacts estimés par des organismes indépendants, en fourchettes.</li>
      <li><strong>5. Glossaire.</strong> Les mots techniques, soulignés en pointillés : touchez-les pour lire leur définition.</li>
    </ol>
    <p class="mt-4 text-ink-600">Les candidats apparaissent dans un ordre tiré au hasard à chaque visite ; vous pouvez le trier de A à Z.</p>
  </section>
</Base>
