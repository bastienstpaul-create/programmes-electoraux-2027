---
import Base from '../layouts/Base.astro';
import StatutBadge from '../components/StatutBadge.astro';
import DateMaj from '../components/DateMaj.astro';
import { getThemes, getDerniereMaj, url, STATUT_MESURE, type StatutAffiche } from '../lib/data';
const themes = await getThemes();
const maj = await getDerniereMaj();
const blocs = [
  ['Situation actuelle', 'les chiffres récents et les règles en vigueur'],
  ['Bilan', 'ce que disent les évaluations des politiques déjà menées'],
  ['Mesures des candidats', 'un tableau comparatif, question par question'],
  ['Effets attendus', 'coûts et impacts estimés par les évaluateurs, en fourchettes'],
  ['Glossaire', 'chaque terme technique expliqué simplement'],
];
---
<Base title="Accueil">
  <h1 class="text-2xl font-bold sm:text-3xl">Présidentielle 2027 : comparer les programmes, thème par thème</h1>
  <p class="mt-3 text-lg">Un outil pour comprendre ce que proposent les candidats, sans avis ni classement. Chaque mesure renvoie au document du candidat, chaque chiffre à sa source.</p>
  <DateMaj date={maj} libelle="Dernière mise à jour :" />

  <h2 class="mt-8 text-xl font-bold">Comment lire une fiche thème</h2>
  <ol class="mt-3 space-y-2">
    {blocs.map(([t, d], i) => <li class="carte flex gap-3 p-3"><span class="font-bold text-slate-400">{i + 1}</span><span><strong>{t}</strong> : {d}.</span></li>)}
  </ol>
  <p class="mt-4">Les mots <button type="button" class="terme" disabled>soulignés en pointillés</button> sont expliqués dans le glossaire : touchez-les pour afficher leur définition.</p>
  <p class="mt-4">Chaque mesure porte un statut :</p>
  <ul class="mt-2 space-y-2">
    {(Object.keys(STATUT_MESURE) as StatutAffiche[]).map((s) => <li class="flex flex-wrap items-center gap-2"><StatutBadge statut={s} /> <span class="text-sm">{STATUT_MESURE[s].aide}</span></li>)}
  </ul>

  <h2 class="mt-8 text-xl font-bold">Les thèmes</h2>
  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
    {themes.map((t) => (
      <li>
        <a href={url(`/themes/${t.id}/`)} class="carte block p-3 no-underline hover:border-slate-400">
          <span class="font-semibold">{t.data.numero}. {t.data.titre}</span>
          {t.data.sous_titre && <span class="block text-sm text-slate-600 dark:text-slate-400">{t.data.sous_titre}</span>}
          {t.data.etat === 'en-preparation' && <span class="mt-1 block text-xs italic text-slate-500">Fiche en préparation</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
