---
import Base from '../../layouts/Base.astro';
import Bulletin from '../../components/Bulletin.astro';
import { getCandidats, STATUT_CANDIDAT, formatDate } from '../../lib/data';
const candidats = await getCandidats();
---
<Base title="Candidats" large>
  <div class="prose-w">
    <h1 class="text-2xl">Les candidats</h1>
    <p class="mt-3 text-ink-600">Les {candidats.length} candidats déclarés ou investis dont les propositions sont suivies ici. D'autres seront ajoutés au fil des déclarations.</p>
    <p class="mt-2 flex items-center gap-2 text-sm text-ink-600"><span data-ordre-libelle>Ordre aléatoire</span>
      <button type="button" data-ordre-bascule class="min-h-[44px] font-semibold text-accent underline underline-offset-2">Trier de A à Z</button></p>
  </div>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {candidats.map((c) => (
      <li data-candidat={c.id} class="flex flex-col gap-2">
        <Bulletin candidat={c} />
        <p class="px-1 text-sm text-ink-600">
          <a href={c.data.statut_source} rel="noopener" target="_blank">{STATUT_CANDIDAT[c.data.statut]}{c.data.date_statut && ` le ${formatDate(c.data.date_statut)}`}</a>
        </p>
      </li>
    ))}
  </ul>
</Base>
