---
import Base from '../../layouts/Base.astro';
import MesureCard from '../../components/MesureCard.astro';
import BandeauFactice from '../../components/BandeauFactice.astro';
import { getCandidats, getThemes, getMesuresCandidat, nomComplet, STATUT_CANDIDAT, formatDate, url, type Candidat } from '../../lib/data';

export async function getStaticPaths() {
  return (await getCandidats()).map((c) => ({ params: { id: c.id }, props: { candidat: c } }));
}
const { candidat } = Astro.props as { candidat: Candidat };
const c = candidat.data;
const themes = (await getThemes()).filter((t) => t.data.etat === 'publie');
const mesures = await getMesuresCandidat(candidat.id);
---
<Base title={nomComplet(candidat)}>
  <p class="text-sm"><a href={url('/candidats/')}>Candidats</a></p>
  <h1 class="mt-1 text-2xl font-bold">{nomComplet(candidat)}</h1>
  <p>{c.parti}</p>
  <p class="mt-1 text-sm"><a href={c.statut_source} rel="noopener" target="_blank">{STATUT_CANDIDAT[c.statut]}</a> · vérifié le {formatDate(c.date_verification)}</p>
  <p class="mt-2">{c.programme_url ? <a href={c.programme_url} rel="noopener" target="_blank">Programme officiel ↗</a> : <span class="italic">Programme officiel non publié à ce jour.</span>}</p>
  {c.factice && <BandeauFactice />}

  <div class="mt-6 space-y-8">
    {themes.map((t) => (
      <section aria-labelledby={`t-${t.id}`}>
        <h2 id={`t-${t.id}`} class="text-xl font-bold"><a href={url(`/themes/${t.id}/#mesures`)} class="no-underline hover:underline">{t.data.numero}. {t.data.titre}</a></h2>
        <div class="mt-3 space-y-4">
          {t.data.axes.map((a) => (
            <div>
              <h3 class="mb-1 text-sm font-semibold text-slate-600 dark:text-slate-400">{a.libelle}</h3>
              <MesureCard mesure={mesures.find((m) => m.data.theme.id === t.id && m.data.axe === a.id)} />
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
