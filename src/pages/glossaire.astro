---
import Base from '../layouts/Base.astro';
import { getGlossaire } from '../lib/data';
const termes = await getGlossaire();
const lettre = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').charAt(0).toUpperCase();
const groupes = new Map<string, typeof termes>();
for (const t of termes) { const l = lettre(t.data.terme); groupes.set(l, [...(groupes.get(l) ?? []), t]); }
---
<Base title="Glossaire">
  <h1 class="text-2xl">Glossaire</h1>
  <p class="mt-3 text-ink-600">Les mots techniques utilisés sur le site, expliqués simplement.</p>
  {termes.length === 0 && <p class="carte mt-6">Le glossaire se remplit au fur et à mesure des fiches thèmes.</p>}
  <nav aria-label="Lettres" class="mt-6 flex flex-wrap gap-1">{[...groupes.keys()].map((l) => <a href={`#lettre-${l}`} class="grid size-11 place-items-center rounded-lg border border-line font-semibold text-ink-900 no-underline hover:border-ink-400">{l}</a>)}</nav>
  {[...groupes].map(([l, ts]) => (
    <section id={`lettre-${l}`} aria-label={`Lettre ${l}`} class="mt-10">
      <h2 class="border-b border-line pb-2 text-xl">{l}</h2>
      <dl class="mt-4 space-y-6">
        {ts.map((t) => (
          <div id={t.id} class="rounded-lg target:bg-accent-50 target:p-3">
            <dt class="text-lg font-semibold"><a href={`#${t.id}`} class="text-ink-900 no-underline hover:underline">{t.data.terme}</a></dt>
            <dd class="mt-1">{t.data.definition}</dd>
            {t.data.exemple && <dd class="mt-1 text-ink-600">Exemple : {t.data.exemple}</dd>}
            {t.data.lien && <dd class="mt-1 text-sm"><a href={t.data.lien.url} rel="noopener" target="_blank">{t.data.lien.titre} ↗</a></dd>}
          </div>
        ))}
      </dl>
    </section>
  ))}
</Base>
