---
import Base from '../layouts/Base.astro';
import { getGlossaire } from '../lib/data';
const termes = await getGlossaire();
const lettre = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').charAt(0).toUpperCase();
const groupes = new Map<string, typeof termes>();
for (const t of termes) { const l = lettre(t.data.terme); groupes.set(l, [...(groupes.get(l) ?? []), t]); }
---
<Base title="Glossaire">
  <h1 class="text-2xl font-bold">Glossaire</h1>
  <nav aria-label="Lettres" class="mt-3 flex flex-wrap gap-2">{[...groupes.keys()].map((l) => <a href={`#lettre-${l}`} class="rounded border border-slate-300 px-2 no-underline dark:border-slate-700">{l}</a>)}</nav>
  {[...groupes].map(([l, ts]) => (
    <section id={`lettre-${l}`} class="mt-6 scroll-mt-20">
      <h2 class="text-xl font-bold">{l}</h2>
      <dl class="mt-2 space-y-3">
        {ts.map((t) => (
          <div id={t.id} class="carte scroll-mt-20 target:border-slate-800 dark:target:border-slate-200">
            <dt class="font-semibold"><a href={`#${t.id}`} class="no-underline">{t.data.terme}</a></dt>
            <dd class="mt-1">{t.data.definition}</dd>
            {t.data.exemple && <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400"><em>Exemple :</em> {t.data.exemple}</dd>}
            {t.data.lien && <dd class="mt-1 text-sm"><a href={t.data.lien.url} rel="noopener" target="_blank">{t.data.lien.titre} ↗</a></dd>}
          </div>
        ))}
      </dl>
    </section>
  ))}
</Base>
