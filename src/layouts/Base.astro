---
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import { url } from '../lib/data';
interface Props { title: string; description?: string; large?: boolean }
const { title, description = 'Comparateur neutre et sourcé des programmes des candidats à la présidentielle 2027.', large = false } = Astro.props;
const titre = title === 'Accueil' ? 'Présidentielle 2027 – Comparateur des programmes' : `${title} – Présidentielle 2027`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{titre}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-20 focus:bg-white focus:p-2">Aller au contenu</a>
    <Entete />
    <main id="contenu" class:list={['mx-auto w-full flex-1 px-4 py-6', large ? 'max-w-6xl' : 'max-w-3xl']} data-pagefind-body>
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-600 dark:text-slate-400">
        <p>Outil d'information indépendant, non affilié à un parti ni à un candidat. Toutes les sources sont consultables.</p>
        <p class="mt-1"><a href={url('/methode/')}>Méthode et sources</a> · <a href={url('/methode/#signaler')}>Signaler une erreur</a></p>
      </div>
    </footer>
  </body>
</html>
