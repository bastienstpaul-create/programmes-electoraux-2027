---
/**
 * Carte mesure : résumé + statut, puis « Détails » (accordéon) :
 * précisions, citation, chiffrage annoncé, coût selon évaluateurs, source.
 */
import type { Mesure, Candidat } from '../lib/data';
import { formatDate } from '../lib/data';
import StatutBadge from './StatutBadge.astro';
import Texte from './Texte.astro';
import SourceLien from './SourceLien.astro';
import Bulletin from './Bulletin.astro';
interface Props { mesure?: Mesure; candidat?: Candidat }
const { mesure, candidat } = Astro.props;
const d = mesure?.data;
const statut = d?.statut ?? 'vide';
const uid = `det-${mesure?.id ?? 'vide'}-${Math.random().toString(36).slice(2, 7)}`;
const vide: Record<string, string> = {
  aucune: 'Pas de proposition identifiée sur ce point.',
  'non-publie': 'Programme écrit non publié sur ce point à ce jour.',
  vide: 'Point pas encore vérifié.',
};
const aDetails = !!d && !!(d.detail || d.citation || d.chiffrage_annonce || d.cout || d.evaluations.length || d.source);
---
<article class="flex h-full flex-col gap-2.5 rounded-[var(--radius-card)] border border-line bg-white p-4">
  {candidat && <div class="-mx-1 -mt-1"><Bulletin candidat={candidat} /></div>}
  <div><StatutBadge statut={statut} /></div>
  {d?.intitule
    ? <p class="font-semibold leading-snug"><Texte texte={d.intitule} inline /></p>
    : <p class="text-ink-600">{vide[statut]}</p>}

  {aDetails && (
    <div class="mt-auto">
      <button type="button" data-accordeon aria-expanded="false" aria-controls={uid}
        class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-accent">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chevron transition-transform"><path d="m6 9 6 6 6-6"/></svg>
        Détails
      </button>
      <div id={uid} hidden class="space-y-2.5 border-t border-line pt-3 text-sm">
        {d!.detail && <div class="text-ink-900"><Texte texte={d!.detail} /></div>}
        {d!.citation && <blockquote class="border-l-2 border-line pl-3 italic text-ink-600">« {d!.citation} »</blockquote>}
        {d!.chiffrage_annonce && <p><span class="font-semibold">Chiffrage annoncé par le candidat :</span> <span class="num">{d!.chiffrage_annonce}</span></p>}
        {d!.cout && (
          <p><span class="font-semibold">Coût selon <SourceLien id={d!.cout.source.id} /> :</span> <span class="num">{d!.cout.fourchette}</span>
            {d!.cout.note && <span class="block text-ink-600">{d!.cout.note}</span>}</p>
        )}
        {d!.evaluations.length > 0 && (
          <ul class="space-y-1">{d!.evaluations.map((e) => <li><SourceLien id={e.source.id} /> : {e.resume}{e.fourchette && <span class="num"> ({e.fourchette})</span>}</li>)}</ul>
        )}
        {d!.source && (
          <p class="text-xs text-ink-600">
            <a href={d!.source.url} target="_blank" rel="noopener">Source ↗</a>{' '}
            <span>{d!.source.titre}{d!.source.contexte && `, ${d!.source.contexte}`}. Consulté le {formatDate(d!.source.date_consultation)}.</span>
          </p>
        )}
        <p class="text-xs text-ink-600">Mis à jour le {formatDate(d!.date_maj)}.</p>
      </div>
    </div>
  )}
</article>
<style>
  button[aria-expanded="true"] .chevron { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .chevron { transition: none; } }
</style>
