---
/** Lien vers une source du registre. */
import { getEntry } from 'astro:content';
import { formatDate } from '../lib/data';
interface Props { id: string; fourchette?: string }
const { id } = Astro.props;
const s = await getEntry('sources', id);
if (!s) throw new Error(`Source inconnue : « ${id} »`);
const date = s.data.date_publication ? `, ${formatDate(s.data.date_publication)}` : '';
---
<a href={s.data.url} rel="noopener" target="_blank" class="source">{s.data.organisme}{date}</a>
