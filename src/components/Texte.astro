---
/** Rend un texte de contenu : paragraphes, termes du glossaire [[…]], liens [..](..). */
import Terme from './Terme.astro';
import { segmenter, paragraphes } from '../lib/texte';
interface Props { texte: string; inline?: boolean; class?: string }
const { texte, inline = false, class: cls } = Astro.props;
const blocs = inline ? [texte] : paragraphes(texte);
---
{blocs.map((p) => {
  const segs = segmenter(p);
  const contenu = segs.map((s) =>
    s.type === 'texte' ? s.valeur
    : s.type === 'terme' ? <Terme id={s.id} libelle={s.libelle} />
    : <a href={s.url} rel="noopener" target="_blank">{s.libelle}</a>
  );
  return inline ? <span class={cls}>{contenu}</span> : <p class:list={['mt-3 first:mt-0', cls]}>{contenu}</p>;
})}
