---
import { url } from '../lib/data';
const liens = [
  ['/themes/', 'Thèmes'],
  ['/candidats/', 'Candidats'],
  ['/comparer/', 'Comparer'],
  ['/glossaire/', 'Glossaire'],
  ['/methode/', 'Méthode et sources'],
  ['/recherche/', 'Rechercher'],
];
const courant = Astro.url.pathname;
---
<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-2">
    <a href={url('/')} class="font-bold no-underline">Présidentielle 2027 <span class="hidden font-normal text-slate-500 sm:inline">· comparateur</span></a>
    <div class="flex items-center gap-1">
      <button type="button" id="bascule-theme" class="rounded p-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Basculer mode clair / sombre">
        <span aria-hidden="true" class="dark:hidden">☾</span><span aria-hidden="true" class="hidden dark:inline">☀</span>
      </button>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded p-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Menu"><span class="whitespace-nowrap">☰ <span class="text-sm">Menu</span></span></summary>
        <nav aria-label="Navigation principale (mobile)" class="absolute right-0 mt-1 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
          <ul>{liens.map(([h, l]) => <li><a href={url(h!)} class="block rounded px-3 py-2 no-underline hover:bg-slate-100 dark:hover:bg-slate-800" aria-current={courant.startsWith(h!) ? 'page' : undefined}>{l}</a></li>)}</ul>
        </nav>
      </details>
    </div>
  </div>
  <nav aria-label="Navigation principale" class="mx-auto hidden max-w-6xl px-4 pb-2 lg:block">
    <ul class="flex gap-5 text-sm">{liens.map(([h, l]) => <li><a href={url(h!)} class="no-underline hover:underline aria-[current=page]:font-semibold aria-[current=page]:underline" aria-current={courant.startsWith(h!) ? 'page' : undefined}>{l}</a></li>)}</ul>
  </nav>
</header>
<script>
  document.getElementById('bascule-theme')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
