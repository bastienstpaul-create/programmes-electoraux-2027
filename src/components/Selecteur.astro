---
/**
 * Sélecteur de candidats (chips role=checkbox) + ordre + partage.
 * Écran < 1024 px : 2 ou 3 candidats. Écran large : tous par défaut.
 * État dans l'URL : ?c=id1,id2
 */
import Monogramme from './Monogramme.astro';
import { nomComplet, type Candidat } from '../lib/data';
interface Props { candidats: Candidat[]; cible: string; titrePartage: string }
const { candidats, cible, titrePartage } = Astro.props;
---
<div class="selecteur" data-cible={cible}>
<div class="sticky top-[var(--header-h)] z-20 -mx-4 border-b border-line bg-page/95 px-4 py-2 backdrop-blur">
  <div class="flex flex-wrap items-center justify-between gap-x-4">
    <p class="text-sm font-semibold" id={`${cible}-legende`}>
      <span class="lg:hidden">Choisissez 2 ou 3 candidats</span><span class="hidden lg:inline">Candidats affichés</span>
    </p>
    <p class="flex items-center gap-2 text-xs text-ink-600 -my-2">
      <span data-ordre-libelle>Ordre aléatoire</span>
      <button type="button" data-ordre-bascule class="min-h-[44px] font-semibold text-accent underline underline-offset-2">Trier de A à Z</button>
    </p>
  </div>
  <div role="group" aria-labelledby={`${cible}-legende`} class="chips -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:flex-wrap lg:overflow-visible">
    {candidats.map((c) => (
      <button type="button" role="checkbox" aria-checked="true" class="chip flex-none" data-candidat={c.id}>
        <Monogramme candidat={c} /><span class="whitespace-nowrap">{nomComplet(c)}</span>
      </button>
    ))}
  </div>
</div>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm text-ink-600" aria-live="polite" data-message></p>
    <button type="button" class="btn btn-secondary" data-partager={titrePartage}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
      Partager cette comparaison
    </button>
  </div>
</div>

<script>
  import { ordre } from '../scripts/ordre';
  const compact = matchMedia('(max-width: 1023px)');

  document.querySelectorAll<HTMLElement>('.selecteur').forEach((sel) => {
    const zone = document.getElementById(sel.dataset.cible!);
    if (!zone) return;
    const chips = [...sel.querySelectorAll<HTMLButtonElement>('.chip')];
    const msg = sel.querySelector<HTMLElement>('[data-message]')!;
    const tous = chips.map((c) => c.dataset.candidat!);
    const depuisUrl = new URLSearchParams(location.search).get('c')?.split(',').filter((id) => tous.includes(id));
    let choix: Set<string> | null = depuisUrl?.length ? new Set(depuisUrl) : null; // null = défaut

    const max = () => (compact.matches ? 3 : Infinity);
    const actifs = (): Set<string> => {
      if (choix) return compact.matches ? new Set([...choix].sort((a, b) => ordre().indexOf(a) - ordre().indexOf(b)).slice(0, 3)) : choix;
      return new Set(compact.matches ? ordre().slice(0, 2) : tous);
    };

    const rendre = () => {
      const a = actifs();
      chips.forEach((c) => {
        const on = a.has(c.dataset.candidat!);
        c.setAttribute('aria-checked', String(on));
        c.setAttribute('aria-disabled', String(!on && a.size >= max()));
      });
      zone.querySelectorAll<HTMLElement>('[data-candidat]').forEach((el) => { el.hidden = !a.has(el.dataset.candidat!); });
      zone.style.setProperty('--n', String(Math.max(a.size, 1)));
      zone.querySelectorAll<HTMLElement>('[data-si-vide]').forEach((el) => { el.hidden = a.size > 0; });
      msg.textContent = a.size === 0 ? 'Aucun candidat sélectionné.' : compact.matches && a.size === 1 ? 'Ajoutez un candidat pour comparer.' : '';
    };

    const majUrl = () => {
      const u = new URL(location.href);
      u.searchParams.set('c', [...actifs()].join(','));
      history.replaceState(null, '', u);
    };

    chips.forEach((c) => c.addEventListener('click', () => {
      const id = c.dataset.candidat!;
      const a = actifs();
      if (a.has(id)) a.delete(id);
      else if (a.size < max()) a.add(id);
      else { msg.textContent = 'Trois candidats au maximum sur cet écran. Retirez-en un pour en ajouter un autre.'; return; }
      choix = a;
      rendre();
      majUrl();
    }));
    compact.addEventListener('change', rendre);
    document.addEventListener('ordre-change', rendre);
    rendre();
  });
</script>
